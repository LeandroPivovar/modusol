---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Wordmark from '../components/Wordmark.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import {
  aplicacoes,
  beneficios,
  contato,
  contatoFinal,
  cta,
  empresa,
  faq,
  fotos,
  hero,
  passos,
  sobre,
  unsplash,
  type Foto,
} from '../data/site';

/** srcset para fotos do Unsplash com proporção fixa (recorte no CDN). */
const srcset = (foto: Foto, larguras: number[], proporcao?: number) =>
  larguras
    .map((w) => `${unsplash(foto.id, w, proporcao ? Math.round(w / proporcao) : undefined)} ${w}w`)
    .join(', ');

const heroLarguras = [640, 960, 1280, 1600, 2000];
const ano = new Date().getFullYear();
const creditos = [fotos.hero, fotos.residencial, fotos.metalica, fotos.solo];
---
<Layout>
  <Header />

  <main id="conteudo">
    <!-- Abertura -->
    <section class="hero wrap" id="topo" aria-labelledby="hero-titulo">
      <div class="hero__location"><span>Energia solar para o seu imóvel</span><span>{empresa.cidade}, {empresa.estado}</span></div>
      <div class="hero__intro">
        <h1 id="hero-titulo">{hero.titulo.split('. ').map((linha, i) => <>{i > 0 && <br />}{linha}{i === 0 && '.'}</>)}</h1>
        <div class="hero__text">
          <p class="hero__lead">{hero.texto}</p>
          <div class="hero__actions" data-hero-actions>
            <a class="btn btn--primary" href={contato.whatsappUrl} target="_blank" rel="noopener"><WhatsAppIcon />{cta.principal}</a>
          </div>
        </div>
      </div>
      <div class="hero__visual">
        <figure class="hero__media">
          <img src={unsplash(fotos.hero.id, 1600)} srcset={srcset(fotos.hero, heroLarguras)} sizes="(min-width: 960px) 75vw, 100vw" width="1600" height="700" alt={fotos.hero.alt} fetchpriority="high" decoding="async" />
          <figcaption>Imagem ilustrativa</figcaption>
        </figure>
        <a class="hero__discover" href={hero.ctaSecundario.href}>
          <span class="hero__discover-label">Da luz do sol<br />à sua tomada.</span>
          <span class="hero__discover-link">{hero.ctaSecundario.label}<span class="round-arrow" aria-hidden="true">↗</span></span>
        </a>
      </div>
    </section>

    <!-- Benefícios -->
    <section class="benefits" id="energia-solar" aria-labelledby="beneficios-titulo">
      <div class="wrap benefits__grid">
        <div class="benefits__head">
          <h2 id="beneficios-titulo">{beneficios.titulo}</h2>
          <p class="lead">{beneficios.intro}</p>
        </div>
        <ul class="benefits__list">
          {beneficios.itens.map((item) => (
            <li>
              <h3>{item.titulo}</h3>
              <p>{item.texto}</p>
            </li>
          ))}
        </ul>
      </div>
      <div class="wrap">
        <p class="benefits__note">{beneficios.nota}</p>
      </div>
    </section>

    <!-- Aplicações (fotos ilustrativas) -->
    <section class="apps" aria-labelledby="aplicacoes-titulo">
      <div class="wrap">
        <div class="apps__head">
          <h2 id="aplicacoes-titulo">{aplicacoes.titulo}</h2>
          <p>{aplicacoes.texto}</p>
        </div>

        <div class="apps__mosaic">
          {[fotos.residencial, fotos.metalica, fotos.solo].map((foto, i) => (
            <figure class:list={['apps__item', { 'apps__item--wide': i === 0 }]}>
              <div class="apps__frame">
                <img
                  src={unsplash(foto.id, 960, 1120)}
                  srcset={srcset(foto, [480, 720, 960], 6 / 7)}
                  sizes="(min-width: 960px) 31vw, (min-width: 640px) 47vw, 100vw"
                  width="960"
                  height="1120"
                  alt={foto.alt}
                  loading="lazy"
                  decoding="async"
                  style={foto.posicao ? `object-position: ${foto.posicao}` : undefined}
                />
              </div>
              <figcaption>{foto.legenda}</figcaption>
            </figure>
          ))}
        </div>

        <div class="apps__foot">
          <p>{aplicacoes.aviso}</p>
          <a class="text-link" href={contato.instagramUrl} target="_blank" rel="noopener">
            {aplicacoes.instagramChamada}
          </a>
        </div>
      </div>
    </section>

    <!-- Como começar -->
    <section class="steps on-dark" id="como-comecar" aria-labelledby="passos-titulo">
      <div class="wrap">
        <div class="steps__head">
          <h2 id="passos-titulo">{passos.titulo}</h2>
          <p>{passos.intro}</p>
        </div>
        <ol class="steps__list">
          {passos.itens.map((item) => (
            <li>
              <h3>{item.titulo}</h3>
              <p>{item.texto}</p>
            </li>
          ))}
        </ol>
        <div class="steps__action">
          <a class="btn btn--primary" href={contato.whatsappUrl} target="_blank" rel="noopener">
            <WhatsAppIcon />
            {cta.principal}
          </a>
          <p>{passos.observacao}</p>
        </div>
      </div>
    </section>

    <!-- Sobre -->
    <section class="about" id="sobre" aria-labelledby="sobre-titulo">
      <div class="wrap about__grid">
        <div class="about__text">
          <h2 id="sobre-titulo">{sobre.titulo}</h2>
          {sobre.paragrafos.map((p) => <p>{p}</p>)}
          <dl class="about__facts">
            <div>
              <dt>Atuação</dt>
              <dd>{empresa.atuacao}</dd>
            </div>
            <div>
              <dt>Localização</dt>
              <dd>{empresa.cidade} — {empresa.uf}</dd>
            </div>
            <div>
              <dt>WhatsApp</dt>
              <dd><a class="text-link" href={contato.whatsappUrl} target="_blank" rel="noopener">{contato.whatsappExibicao}</a></dd>
            </div>
            <div>
              <dt>Instagram</dt>
              <dd><a class="text-link" href={contato.instagramUrl} target="_blank" rel="noopener" translate="no">{contato.instagramHandle}</a></dd>
            </div>
          </dl>
        </div>

        <figure class="about__quote">
          <blockquote>
            <p>“{empresa.lema}”</p>
          </blockquote>
          <figcaption>Mensagem da Modusol no Instagram</figcaption>
        </figure>
      </div>
    </section>

    <!-- Perguntas frequentes -->
    <section class="faq" id="duvidas" aria-labelledby="faq-titulo">
      <div class="wrap faq__grid">
        <div class="faq__head">
          <h2 id="faq-titulo">{faq.titulo}</h2>
          <p>
            {faq.intro}
            <a class="text-link" href={contato.whatsappUrl} target="_blank" rel="noopener">Pergunte pelo WhatsApp</a>
          </p>
        </div>
        <div class="faq__list">
          {faq.itens.map((item) => (
            <details name="perguntas">
              <summary>
                <span>{item.pergunta}</span>
                <span class="faq__icon" aria-hidden="true"></span>
              </summary>
              <p>{item.resposta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Contato -->
    <section class="contact" id="contato" aria-labelledby="contato-titulo">
      <div class="wrap contact__inner">
        <h2 id="contato-titulo">{contatoFinal.titulo}</h2>
        <div class="contact__side">
          <p>{contatoFinal.texto}</p>
          <a class="btn btn--dark" href={contato.whatsappUrl} target="_blank" rel="noopener">
            <WhatsAppIcon />
            {cta.final}
          </a>
          <p class="contact__alt">
            Ou acompanhe no Instagram:{' '}
            <a href={contato.instagramUrl} target="_blank" rel="noopener" translate="no">{contato.instagramHandle}</a>
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer on-dark" data-footer>
    <div class="wrap site-footer__top">
      <div>
        <Wordmark tone="dark" />
        <p class="site-footer__place">{empresa.cidade} — {empresa.uf}</p>
      </div>
      <ul class="site-footer__links">
        <li>
          <a href={contato.whatsappUrl} target="_blank" rel="noopener">WhatsApp {contato.whatsappExibicao}</a>
        </li>
        <li>
          <a href={contato.instagramUrl} target="_blank" rel="noopener">
            Instagram <span translate="no">{contato.instagramHandle}</span>
          </a>
        </li>
      </ul>
    </div>
    <div class="wrap site-footer__signature" aria-hidden="true" translate="no">modusol<span>.</span></div>
    <div class="wrap site-footer__bottom">
      <p>© {ano} <span translate="no">{empresa.nome}</span></p>
      <p>
        Fotos ilustrativas via Unsplash:{' '}
        {creditos.map((foto, i) => (
          <>
            <a href={foto.fonteUrl} target="_blank" rel="noopener">{foto.autor}</a>{i < creditos.length - 1 ? (i === creditos.length - 2 ? ' e ' : ', ') : '.'}
          </>
        ))}
      </p>
    </div>
  </footer>

  <!-- Botão fixo de orçamento (somente celular/tablet) -->
  <div class="mobile-cta" data-mobile-cta>
    <a class="btn btn--primary" href={contato.whatsappUrl} target="_blank" rel="noopener" tabindex="-1" data-mobile-cta-link>
      <WhatsAppIcon />
      {cta.curto}
    </a>
  </div>
</Layout>

<script>
  // Mostra o botão fixo só quando os CTAs da abertura e o contato final estão fora da tela.
  const bar = document.querySelector<HTMLElement>('[data-mobile-cta]');
  const link = document.querySelector<HTMLElement>('[data-mobile-cta-link]');
  const watched = [
    document.querySelector('[data-hero-actions]'),
    document.querySelector('#contato'),
    document.querySelector('[data-footer]'),
  ].filter((el): el is Element => el !== null);

  if (bar && link && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const update = () => {
      const show = visible.size === 0 && !document.documentElement.classList.contains('menu-open');
      bar.classList.toggle('is-visible', show);
      link.tabIndex = show ? 0 : -1;
    };
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) visible.add(entry.target);
        else visible.delete(entry.target);
      });
      update();
    });
    watched.forEach((el) => observer.observe(el));
    new MutationObserver(update).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });
  }
</script>
