---
/**
 * Assinatura tipográfica provisória.
 * O logo original só está disponível em baixa resolução (avatar do Instagram);
 * substitua por um arquivo vetorial ou PNG em alta quando a Modusol enviar.
 */
interface Props {
  tone?: 'light' | 'dark';
}
const { tone = 'light' } = Astro.props;
---
<span class:list={['wordmark', `wordmark--${tone}`]} translate="no">
  <span class="wordmark__name">Modusol</span>
  <span class="wordmark__sub">Energia Solar</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
  }

  .wordmark__name {
    position: relative;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.065em;
    color: var(--navy);
    padding-left: 1rem;
  }

  /* pequeno “sol” amarelo, referência ao símbolo do logo */
  .wordmark__name::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.2em;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--orange);
  }

  .wordmark__sub {
    margin-top: 0.15rem;
    padding-left: 0.95rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }

  .wordmark--dark .wordmark__name {
    color: var(--white);
  }

  .wordmark--dark .wordmark__sub {
    color: var(--on-navy-soft);
  }
</style>
