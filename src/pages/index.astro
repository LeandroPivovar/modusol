---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Wordmark from '../components/Wordmark.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import {
  aplicacoes,
  beneficios,
  contato,
  contatoFinal,
  cta,
  empresa,
  faq,
  fotos,
  hero,
  passos,
  sobre,
  unsplash,
  type Foto,
} from '../data/site';

/** srcset para fotos do Unsplash com proporção fixa (recorte no CDN). */
const srcset = (foto: Foto, larguras: number[], proporcao?: number) =>
  larguras
    .map((w) => `${unsplash(foto.id, w, proporcao ? Math.round(w / proporcao) : undefined)} ${w}w`)
    .join(', ');

const heroLarguras = [640, 960, 1280, 1600, 2000];
const ano = new Date().getFullYear();
const creditos = [fotos.hero, fotos.residencial, fotos.metalica, fotos.solo];
---
<Layout>
  <Header />

  <main id="conteudo">
    <!-- Abertura -->
    <section class="hero" id="topo" aria-labelledby="hero-titulo">
      <div class="hero__text">
        <p class="hero__place">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z" fill="currentColor" />
          </svg>
          {empresa.cidade}, {empresa.estado}
        </p>
        <h1 id="hero-titulo">{hero.titulo}</h1>
        <p class="hero__lead">{hero.texto}</p>
        <div class="hero__actions" data-hero-actions>
          <a class="btn btn--primary" href={contato.whatsappUrl} target="_blank" rel="noopener">
            <WhatsAppIcon />
            {cta.principal}
          </a>
          <a class="btn btn--ghost" href={hero.ctaSecundario.href}>{hero.ctaSecundario.label}</a>
        </div>
      </div>

      <figure class="hero__media">
        <img
          src={unsplash(fotos.hero.id, 1280)}
          srcset={srcset(fotos.hero, heroLarguras)}
          sizes="(min-width: 960px) 54vw, 100vw"
          width="1280"
          height="960"
          alt={fotos.hero.alt}
          fetchpriority="high"
          decoding="async"
          style={`object-position: ${fotos.hero.posicao}`}
        />
        <figcaption>Imagem ilustrativa</figcaption>
      </figure>
    </section>

    <!-- Benefícios -->
    <section class="benefits" id="energia-solar" aria-labelledby="beneficios-titulo">
      <div class="wrap benefits__grid">
        <div class="benefits__head">
          <h2 id="beneficios-titulo">{beneficios.titulo}</h2>
          <p class="lead">{beneficios.intro}</p>
        </div>
        <ul class="benefits__list">
          {beneficios.itens.map((item) => (
            <li>
              <h3>{item.titulo}</h3>
              <p>{item.texto}</p>
            </li>
          ))}
        </ul>
      </div>
      <div class="wrap">
        <p class="benefits__note">{beneficios.nota}</p>
      </div>
    </section>

    <!-- Aplicações (fotos ilustrativas) -->
    <section class="apps" aria-labelledby="aplicacoes-titulo">
      <div class="wrap">
        <div class="apps__head">
          <h2 id="aplicacoes-titulo">{aplicacoes.titulo}</h2>
          <p>{aplicacoes.texto}</p>
        </div>

        <div class="apps__mosaic">
          {[fotos.residencial, fotos.metalica, fotos.solo].map((foto, i) => (
            <figure class:list={['apps__item', { 'apps__item--wide': i === 0 }]}>
              <div class="apps__frame">
                <img
                  src={unsplash(foto.id, 960, i === 0 ? 1.25 : 1.6)}
                  srcset={srcset(foto, [480, 720, 960, 1280], i === 0 ? 1.25 : 1.6)}
                  sizes={i === 0 ? '(min-width: 960px) 58vw, 100vw' : '(min-width: 960px) 38vw, 100vw'}
                  width="960"
                  height={i === 0 ? 768 : 600}
                  alt={foto.alt}
                  loading="lazy"
                  decoding="async"
                  style={foto.posicao ? `object-position: ${foto.posicao}` : undefined}
                />
              </div>
              <figcaption>{foto.legenda}</figcaption>
            </figure>
          ))}
        </div>

        <div class="apps__foot">
          <p>{aplicacoes.aviso}</p>
          <a class="text-link" href={contato.instagramUrl} target="_blank" rel="noopener">
            {aplicacoes.instagramChamada}
          </a>
        </div>
      </div>
    </section>

    <!-- Como começar -->
    <section class="steps on-dark" id="como-comecar" aria-labelledby="passos-titulo">
      <div class="wrap">
        <div class="steps__head">
          <h2 id="passos-titulo">{passos.titulo}</h2>
          <p>{passos.intro}</p>
        </div>
        <ol class="steps__list">
          {passos.itens.map((item) => (
            <li>
              <h3>{item.titulo}</h3>
              <p>{item.texto}</p>
            </li>
          ))}
        </ol>
        <div class="steps__action">
          <a class="btn btn--primary" href={contato.whatsappUrl} target="_blank" rel="noopener">
            <WhatsAppIcon />
            {cta.principal}
          </a>
          <p>{passos.observacao}</p>
        </div>
      </div>
    </section>

    <!-- Sobre -->
    <section class="about" id="sobre" aria-labelledby="sobre-titulo">
      <div class="wrap about__grid">
        <div class="about__text">
          <h2 id="sobre-titulo">{sobre.titulo}</h2>
          {sobre.paragrafos.map((p) => <p>{p}</p>)}
          <dl class="about__facts">
            <div>
              <dt>Atuação</dt>
              <dd>{empresa.atuacao}</dd>
            </div>
            <div>
              <dt>Localização</dt>
              <dd>{empresa.cidade} — {empresa.uf}</dd>
            </div>
            <div>
              <dt>WhatsApp</dt>
              <dd><a class="text-link" href={contato.whatsappUrl} target="_blank" rel="noopener">{contato.whatsappExibicao}</a></dd>
            </div>
            <div>
              <dt>Instagram</dt>
              <dd><a class="text-link" href={contato.instagramUrl} target="_blank" rel="noopener" translate="no">{contato.instagramHandle}</a></dd>
            </div>
          </dl>
        </div>

        <figure class="about__quote">
          <blockquote>
            <p>“{empresa.lema}”</p>
          </blockquote>
          <figcaption>Mensagem da Modusol no Instagram</figcaption>
        </figure>
      </div>
    </section>

    <!-- Perguntas frequentes -->
    <section class="faq" id="duvidas" aria-labelledby="faq-titulo">
      <div class="wrap faq__grid">
        <div class="faq__head">
          <h2 id="faq-titulo">{faq.titulo}</h2>
          <p>
            {faq.intro}
            <a class="text-link" href={contato.whatsappUrl} target="_blank" rel="noopener">Pergunte pelo WhatsApp</a>
          </p>
        </div>
        <div class="faq__list">
          {faq.itens.map((item) => (
            <details>
              <summary>
                <span>{item.pergunta}</span>
                <span class="faq__icon" aria-hidden="true"></span>
              </summary>
              <p>{item.resposta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Contato -->
    <section class="contact" id="contato" aria-labelledby="contato-titulo">
      <div class="wrap contact__inner">
        <h2 id="contato-titulo">{contatoFinal.titulo}</h2>
        <div class="contact__side">
          <p>{contatoFinal.texto}</p>
          <a class="btn btn--dark" href={contato.whatsappUrl} target="_blank" rel="noopener">
            <WhatsAppIcon />
            {cta.final}
          </a>
          <p class="contact__alt">
            Ou acompanhe no Instagram:{' '}
            <a href={contato.instagramUrl} target="_blank" rel="noopener" translate="no">{contato.instagramHandle}</a>
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer on-dark" data-footer>
    <div class="wrap site-footer__top">
      <div>
        <Wordmark tone="dark" />
        <p class="site-footer__place">{empresa.cidade} — {empresa.uf}</p>
      </div>
      <ul class="site-footer__links">
        <li>
          <a href={contato.whatsappUrl} target="_blank" rel="noopener">WhatsApp {contato.whatsappExibicao}</a>
        </li>
        <li>
          <a href={contato.instagramUrl} target="_blank" rel="noopener">
            Instagram <span translate="no">{contato.instagramHandle}</span>
          </a>
        </li>
      </ul>
    </div>
    <div class="wrap site-footer__bottom">
      <p>© {ano} <span translate="no">{empresa.nome}</span></p>
      <p>
        Fotos ilustrativas via Unsplash:{' '}
        {creditos.map((foto, i) => (
          <>
            <a href={foto.fonteUrl} target="_blank" rel="noopener">{foto.autor}</a>{i < creditos.length - 1 ? (i === creditos.length - 2 ? ' e ' : ', ') : '.'}
          </>
        ))}
      </p>
    </div>
  </footer>

  <!-- Botão fixo de orçamento (somente celular/tablet) -->
  <div class="mobile-cta" data-mobile-cta>
    <a class="btn btn--primary" href={contato.whatsappUrl} target="_blank" rel="noopener" tabindex="-1" data-mobile-cta-link>
      <WhatsAppIcon />
      {cta.curto}
    </a>
  </div>
</Layout>

<script>
  // Mostra o botão fixo só quando os CTAs da abertura e o contato final estão fora da tela.
  const bar = document.querySelector<HTMLElement>('[data-mobile-cta]');
  const link = document.querySelector<HTMLElement>('[data-mobile-cta-link]');
  const watched = [
    document.querySelector('[data-hero-actions]'),
    document.querySelector('#contato'),
    document.querySelector('[data-footer]'),
  ].filter((el): el is Element => el !== null);

  if (bar && link && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const update = () => {
      const show = visible.size === 0 && !document.documentElement.classList.contains('menu-open');
      bar.classList.toggle('is-visible', show);
      link.tabIndex = show ? 0 : -1;
    };
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) visible.add(entry.target);
        else visible.delete(entry.target);
      });
      update();
    });
    watched.forEach((el) => observer.observe(el));
    new MutationObserver(update).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });
  }
</script>

<style>
  /* ---------- Abertura ---------- */
  .hero {
    display: grid;
    background: var(--bg);
  }

  .hero__text {
    padding: clamp(2.5rem, 7vw, 4rem) var(--gutter) clamp(2.5rem, 7vw, 3.5rem);
  }

  .hero__place {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
    font-size: 0.975rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .hero__place svg {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--orange-ink);
  }

  .hero h1 {
    font-size: clamp(2.9rem, 1.5rem + 5vw, 5.4rem);
    font-weight: 700;
    line-height: 0.96;
    max-width: 12ch;
  }

  .hero__lead {
    max-width: 34rem;
    margin-top: 1.5rem;
    font-size: clamp(1.125rem, 1rem + 0.35vw, 1.25rem);
    color: var(--ink-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero__media {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 3;
    background: var(--navy);
  }

  .hero__media img {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__media figcaption {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 2;
    padding: 0.25rem 0.55rem;
    border-radius: 2px;
    background: rgba(16, 46, 74, 0.82);
    color: var(--white);
    font-size: 0.8rem;
    font-weight: 500;
  }

  @media (max-width: 959.98px) {
    .hero__actions .btn {
      flex: 1 1 auto;
    }
  }

  @media (min-width: 480px) {
    .hero__actions .btn--primary {
      white-space: nowrap;
    }
  }

  @media (min-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.18fr);
      min-height: min(calc(100svh - var(--header-h)), 860px);
    }

    .hero__text {
      align-self: center;
      padding-block: 4.5rem 5rem;
      padding-left: max(var(--gutter), calc((100vw - var(--wrap)) / 2));
      padding-right: clamp(2rem, 4vw, 4.5rem);
    }

    .hero__media {
      aspect-ratio: auto;
    }

    /* Faixa em grade (células do módulo) que sai por trás da foto */
    .hero__media::before {
      content: '';
      position: absolute;
      left: -3.5rem;
      bottom: 0;
      z-index: 0;
      width: 9rem;
      height: 42%;
      border-top: 4px solid var(--yellow);
      background-color: var(--navy);
      background-image:
        linear-gradient(to right, rgba(255, 255, 255, 0.12) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.12) 1px, transparent 1px);
      background-size: 14px 22px;
    }

    .hero__media figcaption {
      right: 1rem;
      bottom: 1rem;
    }
  }

  /* ---------- Benefícios ---------- */
  .benefits {
    padding-block: var(--section-y);
    background: var(--white);
  }

  .benefits__grid {
    display: grid;
    gap: 2.5rem 5rem;
  }

  .lead {
    margin-top: 1.25rem;
    font-size: 1.2rem;
    color: var(--ink-soft);
    max-width: 36rem;
  }

  .benefits__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .benefits__list li {
    position: relative;
    padding-block: 1.6rem;
    border-top: 1px solid var(--line);
  }

  .benefits__list li::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 0;
    width: 2.5rem;
    height: 3px;
    background: var(--orange);
  }

  .benefits__list p {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    max-width: 38rem;
  }

  .benefits__note {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding: 1.25rem 1.5rem;
    border-left: 4px solid var(--yellow);
    background: var(--bg);
    font-size: 1.05rem;
    color: var(--ink);
    max-width: 62rem;
  }

  @media (min-width: 960px) {
    .benefits__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }

    .benefits__head {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }

    .benefits__list li:first-child {
      padding-top: 0;
      border-top: 0;
    }

    .benefits__list li:first-child::before {
      display: none;
    }
  }

  /* ---------- Aplicações ---------- */
  .apps {
    padding-block: var(--section-y);
  }

  .apps__head {
    display: grid;
    gap: 1rem 4rem;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .apps__head p {
    color: var(--ink-soft);
    max-width: 36rem;
  }

  .apps__mosaic {
    display: grid;
    gap: 1rem;
  }

  .apps__item {
    display: flex;
    flex-direction: column;
    margin: 0;
    min-width: 0;
  }

  .apps__frame {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--line);
  }

  .apps__frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .apps__item figcaption {
    padding-top: 0.65rem;
    font-weight: 600;
    color: var(--navy);
  }

  .apps__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .apps__foot p {
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  @media (min-width: 640px) and (max-width: 959.98px) {
    .apps__mosaic {
      grid-template-columns: 1fr 1fr;
    }

    .apps__item--wide {
      grid-column: 1 / -1;
    }

    .apps__item--wide .apps__frame {
      aspect-ratio: 16 / 9;
    }
  }

  @media (min-width: 960px) {
    .apps__head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: end;
    }

    .apps__mosaic {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
      grid-template-rows: auto auto;
      gap: 1.25rem 1.5rem;
    }

    .apps__item--wide {
      grid-row: 1 / span 2;
    }

    .apps__item--wide .apps__frame {
      aspect-ratio: auto;
      flex: 1 1 auto;
      min-height: 26rem;
    }
  }

  /* ---------- Como começar ---------- */
  .steps {
    padding-block: var(--section-y);
    background-color: var(--navy);
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 56px 88px;
    color: var(--white);
  }

  .steps h2,
  .steps h3 {
    color: var(--white);
  }

  .steps__head p {
    margin-top: 1rem;
    font-size: 1.2rem;
    color: var(--on-navy-soft);
    max-width: 36rem;
  }

  .steps__list {
    display: grid;
    gap: 2.5rem 2rem;
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: passo;
  }

  .steps__list li {
    counter-increment: passo;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.28);
  }

  .steps__list li::before {
    content: counter(passo);
    display: block;
    margin-bottom: 1rem;
    font-family: var(--font-display);
    font-size: 4.5rem;
    font-weight: 700;
    line-height: 0.85;
    color: var(--yellow);
  }

  .steps__list p {
    margin-top: 0.6rem;
    color: var(--on-navy-soft);
  }

  .steps__action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .steps__action p {
    font-size: 0.975rem;
    color: var(--on-navy-soft);
  }

  @media (min-width: 768px) {
    .steps__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ---------- Sobre ---------- */
  .about {
    padding-block: var(--section-y);
    background: var(--white);
  }

  .about__grid {
    display: grid;
    gap: 3rem 5rem;
  }

  .about__text > p {
    margin-top: 1.1rem;
    color: var(--ink-soft);
    max-width: 34rem;
  }

  .about__facts {
    margin: 2rem 0 0;
    border-top: 1px solid var(--line);
  }

  .about__facts div {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--line);
  }

  .about__facts dt {
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .about__facts dd {
    margin: 0;
    font-weight: 600;
    color: var(--navy);
    overflow-wrap: anywhere;
  }

  .about__quote {
    margin: 0;
    padding: clamp(1.75rem, 4vw, 3rem);
    border-top: 4px solid var(--yellow);
    background-color: var(--navy);
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 28px 44px;
    color: var(--white);
  }

  .about__quote blockquote {
    margin: 0;
  }

  .about__quote blockquote p {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.2rem + 3vw, 3.4rem);
    font-weight: 600;
    line-height: 1.05;
    text-wrap: balance;
  }

  .about__quote figcaption {
    margin-top: 1.5rem;
    font-size: 0.95rem;
    color: var(--on-navy-soft);
  }

  @media (min-width: 960px) {
    .about__grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      align-items: center;
    }

    .about__quote {
      order: -1;
    }
  }

  /* ---------- Perguntas frequentes ---------- */
  .faq {
    padding-block: var(--section-y);
  }

  .faq__grid {
    display: grid;
    gap: 2rem 5rem;
  }

  .faq__head p {
    margin-top: 1rem;
    color: var(--ink-soft);
  }

  .faq__head .text-link {
    margin-left: 0.25rem;
  }

  .faq__list {
    border-top: 1px solid var(--line);
  }

  .faq details {
    border-bottom: 1px solid var(--line);
  }

  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 0;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--navy);
    list-style: none;
    cursor: pointer;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary:hover {
    color: var(--blue);
  }

  .faq__icon {
    position: relative;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border: 2px solid currentColor;
    border-radius: 50%;
  }

  .faq__icon::before,
